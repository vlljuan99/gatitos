# Copiar a /opt/bigotes/app.env en el servidor (chmod 600) y rellenar.
PORT=4000
TZ=Europe/Madrid
PUBLIC_URL=https://bigotes.167-233-99-156.sslip.io

# Primera cuenta de administración. Solo se usa si todavía no hay nadie en el
# equipo; después se puede borrar de aquí (la contraseña se cambia en «Mi cuenta»).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Opcional: si no se indica, se genera y se guarda en data/jwt-secret.txt.
JWT_SECRET=

# Avisos por email (opcional). Hetzner bloquea el SMTP saliente (puertos 25 y
# 465), por eso se usa la API HTTPS de Resend. Sin clave no se envía nada.
RESEND_API_KEY=
MAIL_FROM=
NOTIFY_EMAIL=

# Meses que se guardan solicitudes descartadas y mensajes archivados.
RETENTION_MONTHS=12
